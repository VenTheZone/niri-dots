# Swaylock configuration
# Cyberpunk 2077 dark theme colors

# Background image
image=~/.config/niri/wallpaper/moon.png
scaling=fill

# Ring colors (Cyberpunk yellow / red)
ring-color=#d9bd08
ring-ver-color=#d9bd08
ring-wrong-color=#ff003c
ring-clear-color=#8a8a82

# Inside colors
inside-color=#0a0a0e
inside-ver-color=#0a0a0e
inside-wrong-color=#0a0a0e
inside-clear-color=#0a0a0e

# Line color
line-color=#0a0a0e
line-ver-color=#0a0a0e
line-wrong-color=#0a0a0e
line-clear-color=#0a0a0e

# Separator color
separator-color=#2a2a33

# Text colors
key-hl-color=#d9bd08
bs-hl-color=#ff003c
text-color=#d6d6cd
text-ver-color=#d6d6cd
text-wrong-color=#d6d6cd
text-clear-color=#d6d6cd

# Font
font=JetBrainsMono Nerd Font
font-size=24

# Effects
fade-in=0.2
ignore-empty-password
show-failed-attempts
indicator-radius=120
indicator-thickness=15
indicator-x-position=960
indicator-y-position=540

# Hide keyboard layout
hide-keyboard-layout

# No caps lock indicator
# show-caps-lock-indicator

# Daemonize
# daemonize
