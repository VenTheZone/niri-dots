{
    "layer": "top",
    "position": "top",
    "height": 40,
    "width": "auto",
    "spacing": 8,
    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,

    "modules-left": ["custom/launcher", "custom/niri-workspaces", "custom/media"],
    "modules-center": ["clock"],
    "modules-right": ["tray", "cpu", "memory", "upower", "custom/audio", "custom/power"],

    "custom/launcher": {
        "format": " 󰣇 ",
        "on-click": "fuzzel",
        "tooltip": false
    },

    "custom/power": {
        "format": " 󰐥 ",
        "on-click": "sh -c /home/jt/.local/bin/powermenu",
        "tooltip": false
    },

    "custom/niri-workspaces": {
        "format": "{}",
        "exec": "/home/jt/.config/waybar/scripts/niri-workspaces.sh",
        "interval": 1,
        "tooltip": false
    },

    "custom/media": {
        "format": " 󰝚 {} ",
        "max-length": 35,
        "interval": 2,
        "exec": "playerctl -a metadata --format '{{title}}' 2>/dev/null || echo 'No Media'",
        "on-click": "playerctl play-pause"
    },

    "clock": {
        "format": " 󱑎 {:%I:%M %p  󰃭 %a, %b %d} ",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "interval": 1,
        "locale": "C.utf8"
    },

    "cpu": {
        "format": " {usage}%",
        "interval": 2,
        "tooltip": true,
        "tooltip-format": "CPU Usage: {usage}%\nLoad: {load}"
    },

    "memory": {
        "format": " {used:0.1f}G/{total:0.1f}G ({percentage}%)",
        "interval": 2,
        "tooltip": true,
        "tooltip-format": "RAM: {used:0.1f}GB / {total:0.1f}GB\nSwap: {swapUsed:0.1f}GB / {swapTotal:0.1f}GB"
    },

    "upower": {
        "show-icon": false,
        "format": "  {percentage}% ",
        "interval": 30
    },

    "tray": {
        "icon-size": 18,
        "spacing": 10
    },

    "custom/audio": {
        "exec": "/home/jt/.config/waybar/scripts/audio-control.sh",
        "interval": 0.1,
        "return-type": "json",
        "on-click": "/home/jt/.config/waybar/scripts/audio-selector.sh menu",
        "on-click-right": "/home/jt/.config/waybar/scripts/audio-control.sh toggle",
        "on-scroll-up": "/home/jt/.config/waybar/scripts/audio-control.sh up",
        "on-scroll-down": "/home/jt/.config/waybar/scripts/audio-control.sh down"
    }
}